# ---------- Backend (FastAPI) ----------
# Empty = local SQLite file (backend/paypilot.db). Use Postgres in Docker / production:
# DATABASE_URL=postgresql+psycopg://paypilot:paypilot@localhost:5432/paypilot
DATABASE_URL=

# LLM is optional and never used for authorization.
# Without a key, intent + policy compiling use the deterministic rule parser.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# PayPal Developer → Apps & Credentials → Sandbox app.
# Without credentials, payments are SIMULATED and clearly labelled as such.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_SETTLEMENT_CURRENCY=USD

# Where PayPal redirects buyers after approval, and allowed CORS origins.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enables /api/demo/* (scenario runner + reset).
DEMO_MODE=true

# Optional: require X-PayPilot-Key on mutating endpoints.
PAYPILOT_API_KEY=

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
